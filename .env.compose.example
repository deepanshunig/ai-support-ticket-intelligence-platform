# Copy to .env.compose and replace all values with independent URL-safe secrets.
MYSQL_ROOT_PASSWORD=replace-with-a-random-url-safe-secret
MYSQL_PASSWORD=replace-with-a-different-random-url-safe-secret
TICKET_REVIEWER_TOKEN=replace-with-another-random-url-safe-secret
# Optional. Configure both only when an approved receiving workflow is ready.
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_SECRET=
