# Copy this file to .env in the project root. Do not commit .env.
TICKET_APP_NAME="AI Support Ticket Intelligence Platform"
TICKET_ENVIRONMENT=development
TICKET_LOG_LEVEL=INFO
TICKET_API_HOST=127.0.0.1
TICKET_API_PORT=8000
# Generated for local Windows demo by scripts/setup_local_mysql.py.
# Example: mysql+pymysql://ticket_app:PASSWORD@127.0.0.1:3306/ticket_intelligence
TICKET_DATABASE_URL=
TICKET_REVIEWER_TOKEN=
TICKET_REVIEWER_ID=demo-reviewer
TICKET_ARTIFACT_DIR=artifacts/baselines
TICKET_TEAM_MAPPING_PATH=configs/team_mapping.json
TICKET_API_BASE_URL=http://127.0.0.1:8000
TICKET_POLICY_PATH=artifacts/routing/policy.json
# Optional signed outbound webhook. Leave both blank to keep integration disabled.
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_SECRET=
